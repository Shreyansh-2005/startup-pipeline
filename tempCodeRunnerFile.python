import math

def get_benchmark_er(followers):
    if followers <= 9000:
        return 8.0
    elif followers <= 11000:
        return 8 + (followers - 9000) / (11000 - 9000) * (3.5 - 8)
    elif followers <= 90000:
        return 3.5
    elif followers <= 110000:
        return 3.5 + (followers - 90000) / (110000 - 90000) * (2.0 - 3.5)
    elif followers <= 900000:
        return 2.0
    elif followers <= 1100000:
        return 2.0 + (followers - 900000) / (1100000 - 900000) * (1.42 - 2.0)
    else:
        return 1.42

PLATFORM_WEIGHTS = {
    "youtube": 1.4,
    "instagram": 1.2,
    "tiktok": 1.1,
    "twitch": 1.0,
    "twitter": 0.9,
    "linkedin": 0.9,
    "pinterest": 0.8,
}

PLATFORM_FREQ_BENCHMARKS = {
    "youtube": 1,
    "instagram": 4,
    "tiktok": 5,
    "twitter": 7,
    "linkedin": 3,
    "twitch": 3,
}

def pillar1_engagement(followers, avg_likes, avg_comments):
    weighted_er = (avg_likes * 1 + avg_comments * 2) / followers * 100
    benchmark = get_benchmark_er(followers)
    er_ratio = weighted_er / benchmark
    score = min(er_ratio, 1.25) / 1.25 * 400
    return round(score, 2), round(weighted_er, 4), round(benchmark, 4)

def pillar2_reach(followers, platform):
    platform = platform.lower()
    weight = PLATFORM_WEIGHTS.get(platform, 0.8)
    adjusted = followers * weight
    score = min(math.log10(adjusted) / math.log10(1_400_000), 1) * 250
    return round(score, 2)

def pillar3_consistency(posts_per_week, days_since_last_post, platform):
    platform = platform.lower()
    benchmark = PLATFORM_FREQ_BENCHMARKS.get(platform, 4)
    freq_score = min(posts_per_week / benchmark, 1) * 150

    if days_since_last_post <= 7:
        recency_score = 50
    elif days_since_last_post <= 14:
        recency_score = 25
    elif days_since_last_post <= 30:
        recency_score = 10
    else:
        recency_score = 0

    return round(freq_score + recency_score, 2)

def pillar4b_ctl(avg_comments, avg_likes, followers):
    if avg_likes == 0:
        return 0
    ctl = avg_comments / avg_likes

    if followers <= 100000:          # Nano / Micro
        if ctl >= 0.04:   return 75
        elif ctl >= 0.02: return 37.5
        else:             return 0
    elif followers <= 1000000:       # Macro
        if ctl >= 0.02:   return 75
        elif ctl >= 0.01: return 37.5
        else:             return 0
    else:                            # Mega
        if ctl >= 0.008:  return 75
        elif ctl >= 0.004:return 37.5
        else:             return 0

def pillar4c_growth(growth_status):
    """
    growth_status options:
      'within_er_stable'   -> 75
      'exceeds_er_stable'  -> 37.5
      'exceeds_er_dropped' -> 0
      'unavailable'        -> 37.5
    """
    mapping = {
        "within_er_stable": 75,
        "exceeds_er_stable": 37.5,
        "exceeds_er_dropped": 0,
        "unavailable": 37.5,
    }
    return mapping.get(growth_status, 37.5)

def bonus_platform_diversity(num_platforms):
    if num_platforms >= 3:
        return 30
    elif num_platforms == 2:
        return 15
    else:
        return 0

def bonus_account_age(age_status):
    """
    age_status options:
      'over_1_year'
      '6_to_12_months'
      'under_6_months'
      'unknown'
    """
    mapping = {
        "over_1_year": 20,
        "6_to_12_months": 10,
        "under_6_months": 0,
        "unknown": 10,
    }
    return mapping.get(age_status, 10)

def compute_social_score(creator):
    p1, weighted_er, benchmark_er = pillar1_engagement(
        creator["followers"],
        creator["avg_likes"],
        creator["avg_comments"]
    )
    p2 = pillar2_reach(creator["followers"], creator["platform"])
    p3 = pillar3_consistency(
        creator["posts_per_week"],
        creator["days_since_last_post"],
        creator["platform"]
    )
    p4b = pillar4b_ctl(creator["avg_comments"], creator["avg_likes"], creator["followers"])
    p4c = pillar4c_growth(creator["growth_status"])
    b1  = bonus_platform_diversity(creator["num_platforms"])
    b2  = bonus_account_age(creator["account_age_status"])

    raw = p1 + p2 + p3 + p4b + p4c + b1 + b2
    social_score = (raw / 1050) * 1000

    print(f"\n{'='*45}")
    print(f"  Creator : {creator['name']}")
    print(f"  Platform: {creator['platform'].capitalize()} | Followers: {creator['followers']:,}")
    print(f"{'='*45}")
    print(f"  Weighted ER      : {weighted_er}%  (Benchmark: {benchmark_er}%)")
    print(f"  P1 Engagement    : {p1} / 400")
    print(f"  P2 Reach         : {p2} / 250")
    print(f"  P3 Consistency   : {p3} / 200")
    print(f"  P4B CTL Ratio    : {p4b} / 75")
    print(f"  P4C Growth       : {p4c} / 75")
    print(f"  Bonus Diversity  : {b1} / 30")
    print(f"  Bonus Age        : {b2} / 20")
    print(f"  Raw Score        : {round(raw, 2)} / 1050")
    print(f"  SOCIAL SCORE     : {round(social_score, 1)} / 1000")
    print(f"{'='*45}")

    return round(social_score, 1)


